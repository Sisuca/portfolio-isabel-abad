        <path fill="currentColor" d="M346,604 L346,630 L320,630 L153,630 C138.640597,630 127,618.359403 127,604 L127,183 C127,168.640597 138.640597,157 153,157 L320,157 C334.359403,157 346,168.640597 346,183 L346,604 Z" />
        <path fill="currentColor" d="M219,604 L219,630 L193,630 L26,630 C11.6405965,630 1.75851975e-15,618.359403 0,604 L0,341 C-1.75851975e-15,326.640597 11.6405965,315 26,315 L193,315 C207.359403,315 219,326.640597 219,341 L219,604 Z" />
      </g>
    `,
  },
  dax: {
    viewBox: '0 0 24 24',
    path: `<path fill="currentColor" d="M18 4H6v2l6.5 6L6 18v2h12v-3h-7l5-5-5-5h7z"/>`,
  },
};

const skills = {
  frontend: [
    { name: 'JavaScript', svg: icons.js },
    { name: 'React', svg: icons.react },
    { name: 'TypeScript', svg: icons.typescript },
    { name: 'HTML5', svg: icons.html5 },
    { name: 'CSS3', svg: icons.css3 },
    { name: 'Tailwind CSS', svg: icons.tailwind },
    { name: 'Astro', svg: icons.astro },
    { name: 'Framer Motion', svg: icons.framer },
    { name: 'Vite', svg: icons.vite },
    { name: 'Git', svg: icons.git },
    { name: 'GitHub', svg: icons.github },
  ],
  analyst: [
    { name: 'Supabase', svg: icons.supabase },
    { name: 'PostgreSQL', svg: icons.postgresql },
    { name: 'REST APIs', svg: icons.restapi },
    { name: 'Zod', svg: icons.zod },
    { name: 'SQL', svg: icons.sql },
    { name: 'ETL', svg: icons.etl },
    { name: 'Excel', svg: icons.excel },
    { name: 'Power Query', svg: icons.query },
    { name: 'Tableau', svg: icons.tableau },
    { name: 'Power BI', svg: icons.powerbi },
    { name: 'DAX', svg: icons.dax },
  ],
};

const certLinkIcon = `<svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="7" y1="17" x2="17" y2="7" />
    <polyline points="7 7 17 7 17 17" />
  </svg>`;
---

<Layout title="CV | Isabel Abad">
  <main class="min-h-screen pt-4 pb-20 px-6 md:px-24 lg:px-32">
    <h4 class="text-h2-label text-accent font-bold uppercase tracking-widest mb-12">
      CV
    </h4>

    <a
      href="/#about"
      class="text-text-secondary hover:text-accent text-sm mb-8 inline-block"
    >
      ← Volver a Sobre Mí
    </a>

    <div class="flex flex-col md:flex-row gap-12 md:gap-16">
      {/* COLUMNA IZQUIERDA */}
      <aside class="w-full md:w-[30%] flex flex-col gap-8">
        <div class="w-36 h-36 rounded-full overflow-hidden border-2 border-accent mx-auto md:mx-0 flex-shrink-0">
          <img
            src="/images/isabel-abad.jpg"
            alt="Isabel Abad"
            class="w-full h-full object-cover"
          />
        </div>

        <div class="sticky top-24 self-start flex flex-col gap-8">
          <div class="text-center md:text-left">
            <h1 class="text-3xl font-bold text-text-primary mb-1">
              Isabel Abad
            </h1>
            <p class="text-lg text-accent font-medium mb-3">
              Frontend Developer
            </p>
            <p class="text-base text-text-secondary leading-relaxed mb-1">
              Desarrolladora Frontend con experiencia en marketing digital y
              gestión de proyectos web.
            </p>
            <p class="text-base text-text-secondary leading-relaxed mb-1">
              Especializada en desarrollo web orientado a producto, interfaces
              intuitivas y análisis de datos.
            </p>
            <p class="text-base text-text-secondary leading-relaxed mb-1">
              Experiencia transformando necesidades de negocio en soluciones
              digitales eficientes y coordinando equipos multidisciplinares.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 mt-1">
            <a
              href="/Isabel_Abad_CV.pdf"
              download
              class="sm:flex-1 px-6 py-3 bg-accent text-text-dark font-bold rounded-sm hover:bg-white transition-transition-all duration-300 text-center text-sm whitespace-nowrap"
            >
              Descargar CV (PDF)
            </a>
            <a
              href="/#projects"
              class="sm:flex-1 px-6 py-3 border border-accent text-accent font-bold rounded-sm hover:bg-accent hover:text-black transition-all duration-300 text-center text-sm whitespace-nowrap"
            >
              Ver Proyectos
            </a>
          </div>

          {/* Tech Stack */}
          <div class="mt-4">
            <h3 class="text-sm font-bold text-accent uppercase tracking-widest mb-2 border-b border-gray-800 pb-2">
              Stack Tecnológico
            </h3>

            <div class="mb-8">
              <h4 class="text-text-primary text-base font-semibold capitalize tracking-wide mb-3">
                Frontend Developer
              </h4>
              <div class="flex flex-wrap gap-2">
                {skills.frontend.map((skill) => (
                  <div class="flex items-center gap-1.5 bg-bg-secondary px-3 py-1 border border-gray-700 rounded-full hover:border-accent transition-colors">
                    <svg
                      class="w-5 h-5 text-accent"
                      viewBox={skill.svg.viewBox}
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <Fragment set:html={skill.svg.path} />
                    </svg>
                    <span class="text-sm font-medium text-text-primary">
                      {skill.name}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <h4 class="text-text-primary text-base font-semibold capitalize tracking-wide mb-3">
                Backend &amp; Data Analyst
              </h4>
              <div class="flex flex-wrap gap-2">
                {skills.analyst.map((skill) => (
                  <div class="flex items-center gap-1.5 bg-bg-secondary px-3 py-1 border border-gray-700 rounded-full hover:border-accent transition-colors">
                    <svg
                      class="w-5 h-5 text-accent"
                      viewBox={skill.svg.viewBox}
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <Fragment set:html={skill.svg.path} />
                    </svg>
                    <span class="text-sm font-medium text-text-primary">
                      {skill.name}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </aside>

      {/* COLUMNA DERECHA */}
      <div class="w-full md:w-[70%] flex flex-col gap-12">
        <section>
          <h2 class="text-sm font-bold text-accent uppercase tracking-widest mb-8 border-b border-gray-800 pb-4">
            Experiencia Profesional
          </h2>

          <div class="flex flex-col gap-8">
            {experienceData.map((exp) => (
              <div class="flex flex-col gap-1">
                <div class="flex justify-between items-baseline">
                  <h3 class="text-xl font-bold text-text-primary">
                    {exp.role}
                  </h3>
                  <span class="text-sm font-mono text-accent flex-shrink-0 ml-4">
                    {exp.period}
                  </span>
                </div>
                <p class="text-md text-text-secondary mb-2">{exp.company}</p>
                <p class="text-lg text-text-secondary leading-relaxed mb-2">
                  {exp.description}
                </p>

                {exp.bullets && (
                  <ul class="list-disc pl-5 marker:text-accent text-base text-text-secondary leading-relaxed space-y-1 mt-1">
                    {exp.bullets.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-sm font-bold text-accent uppercase tracking-widest mb-8 border-b border-gray-800 pb-4">
            Certificados
          </h2>

          <div class="flex flex-col gap-8">
            {certificatesData.map((cert) => (
              <div class="flex flex-col gap-1">
                <div class="flex justify-between items-baseline">
                  <h3 class="text-lg font-bold text-text-primary">
                    {cert.name}
                  </h3>
                  <span class="text-sm font-mono text-accent flex-shrink-0 ml-4">
                    {cert.year}
                  </span>
                </div>
                <p class="text-md text-text-secondary mb-2">{cert.issuer}</p>

                <div class="mt-2 flex items-center gap-2">
                  <a
                    href={cert.link}
                    class="hidden md:inline-flex text-sm font-bold text-accent hover:text-white transition-colors items-center gap-1.5 group"
                  >
                    <span>Ver Certificado</span>
                    <Fragment set:html={certLinkIcon} />
                  </a>

                  <a
                    href={cert.link + '.pdf'}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="md:hidden inline-flex text-sm font-bold text-accent hover:text-white transition-colors items-center gap-1.5 group"
                  >
                    <span>Ver Certificado</span>
                    <Fragment set:html={certLinkIcon} />
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
